                                <h4 class="font-serif-title font-bold text-sm text-white mb-2">The Biological Reality:</h4>
                                <p class="text-xs text-linen/90 leading-relaxed">${item.truth}</p>
                            </div>
                            <div class="border-t border-white/10 pt-3 text-[10px] text-eucalyptus">
                                <span class="font-semibold block">Source Reference:</span>
                                <span class="text-gray-300 italic">${item.source}</span>
                            </div>
                        </div>

                    </div>
                `;
                container.appendChild(card);
            });
        }

        function renderReferences() {
            const list = document.getElementById('referenceList');
            const yearVal = document.getElementById('yearFilter').value;
            list.innerHTML = '';

            const filtered = REFERENCES_DATA.filter(ref => {
                if (yearVal === 'all') return true;
                return ref.yearGroup === yearVal;
            });

            filtered.forEach(ref => {
                const card = document.createElement('div');
                card.className = "bg-linen p-5 rounded-2xl border border-eucalyptus/20 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:border-eucalyptus/50 transition-colors";

                card.innerHTML = `
                    <div class="space-y-1.5 max-w-3xl">
                        <div class="flex items-center gap-2">
                            <span class="bg-sage text-linen text-[10px] font-bold px-2.5 py-0.5 rounded-full">${ref.year}</span>
                            <span class="bg-eucalyptus/20 text-sage text-[10px] font-bold px-2.5 py-0.5 rounded-full">${ref.badge}</span>
                        </div>
                        <p class="text-xs sm:text-sm font-medium text-sage font-serif-title">
                            ${ref.authors} (${ref.year}). ${ref.title} <span class="italic text-sage/70">${ref.journal}</span>
                        </p>
                    </div>
                    <a href="${ref.doi}" target="_blank" rel="noopener noreferrer" class="self-start sm:self-center bg-white hover:bg-eucalyptus/10 text-sage border border-eucalyptus/30 text-xs font-semibold px-3.5 py-2 rounded-xl transition-colors whitespace-nowrap flex items-center gap-1.5">
                        <span>View Publication</span>
                        <i class="fa-solid fa-arrow-up-right-from-square text-[10px] text-terracotta"></i>
                    </a>
                `;
                list.appendChild(card);
            });
        }

        function filterReferences() {
            renderReferences();
        }

        function generateCheatSheet() {
            const preview = document.getElementById('cheatSheetPreview');
            const chkSurfactants = document.getElementById('chk-surfactants').checked;
            const chkSilicones = document.getElementById('chk-silicones').checked;
            const chkProteins = document.getElementById('chk-proteins').checked;
            const chkPreservatives = document.getElementById('chk-preservatives').checked;

            let html = `
                <div class="border-b border-sage/20 pb-4 mb-4 flex justify-between items-start">
                    <div>
                        <span class="text-[10px] uppercase font-bold text-terracotta tracking-wider">Hair Science Hub | College Non-Profit</span>
                        <h3 class="font-serif-title text-xl font-bold text-sage">INCI Label Reading Cheat Sheet</h3>
                        <p class="text-[11px] text-sage/70">Evidence-based consumer reference guide for ingredients.</p>
                    </div>
                    <span class="text-[10px] text-sage/50 font-mono">Ver. 2026.1</span>
                </div>
                <div class="space-y-4">
            `;

            if (chkSurfactants) {
                html += `
                    <div class="bg-linen p-3 rounded-xl border border-eucalyptus/20">
                        <h4 class="font-bold text-xs text-sage flex items-center gap-1.5">
                            <i class="fa-solid fa-soap text-terracotta"></i> Surfactants & Cleansers
                        </h4>
                        <div class="grid grid-cols-2 gap-2 mt-2 text-[11px]">
                            <div>
                                <span class="font-semibold text-green-700 block">✔ Look For (Gentle):</span>
                                <p class="text-sage/80">Cocamidopropyl Betaine, Decyl Glucoside, Coco-Glucoside.</p>
                            </div>
                            <div>
                                <span class="font-semibold text-terracotta block">✖ Limit / Caution:</span>
                                <p class="text-sage/80">Unbuffered Sodium Lauryl Sulfate (SLS) on dry or sensitive scalps.</p>
                            </div>
                        </div>
                    </div>
                `;
            }

            if (chkSilicones) {
                html += `
                    <div class="bg-linen p-3 rounded-xl border border-eucalyptus/20">
                        <h4 class="font-bold text-xs text-sage flex items-center gap-1.5">
                            <i class="fa-solid fa-shield text-eucalyptus"></i> Silicones & Polymers
                        </h4>
                        <div class="grid grid-cols-2 gap-2 mt-2 text-[11px]">
                            <div>
                                <span class="font-semibold text-green-700 block">✔ Look For (Auto-Repelling):</span>
                                <p class="text-sage/80">Amodimethicone, PEG-Modified Silicones (won't heavy build-up).</p>
                            </div>
                            <div>
                                <span class="font-semibold text-terracotta block">✖ Require Clarifying:</span>
                                <p class="text-sage/80">High Viscosity Dimethicone without regular clarifying wash.</p>
                            </div>
                        </div>
                    </div>
                `;
            }

            if (chkProteins) {
                html += `
                    <div class="bg-linen p-3 rounded-xl border border-eucalyptus/20">
                        <h4 class="font-bold text-xs text-sage flex items-center gap-1.5">
                            <i class="fa-solid fa-dna text-sage"></i> Proteins & Bond Repair
                        </h4>
                        <div class="grid grid-cols-2 gap-2 mt-2 text-[11px]">
                            <div>
                                <span class="font-semibold text-green-700 block">✔ Must Say "Hydrolyzed":</span>
                                <p class="text-sage/80">Hydrolyzed Wheat Protein, Hydrolyzed Keratin (< 1,000 Da).</p>
                            </div>
                            <div>
                                <span class="font-semibold text-terracotta block">✖ Ineffective DIY:</span>
                                <p class="text-sage/80">Unhydrolyzed raw eggs or collagen food masks (cannot penetrate shaft).</p>
                            </div>
                        </div>
                    </div>
                `;
            }

            if (chkPreservatives) {
                html += `
                    <div class="bg-linen p-3 rounded-xl border border-eucalyptus/20">
                        <h4 class="font-bold text-xs text-sage flex items-center gap-1.5">
                            <i class="fa-solid fa-vial text-terracotta"></i> Preservatives & Alcohols
                        </h4>
                        <div class="grid grid-cols-2 gap-2 mt-2 text-[11px]">
                            <div>
                                <span class="font-semibold text-green-700 block">✔ Non-Irritating / Fatty:</span>
                                <p class="text-sage/80">Phenoxyethanol, Cetearyl Alcohol, Cetyl Alcohol (Moisturizing).</p>
                            </div>
                            <div>
                                <span class="font-semibold text-terracotta block">✖ Sensitizing / Stripping:</span>
                                <p class="text-sage/80">DMDM Hydantoin (Formaldehyde-releaser), Denatured Alcohol.</p>
                            </div>
                        </div>
                    </div>
                `;
            }

            if (!chkSurfactants && !chkSilicones && !chkProteins && !chkPreservatives) {
                html += `<p class="text-center text-sage/50 py-8">Select at least one checkbox on the left to generate your custom cheat sheet.</p>`;
            }

            html += `
                </div>
                <div class="mt-4 pt-3 border-t border-eucalyptus/20 text-[10px] text-sage/60 flex justify-between">
                    <span>Cited: Harvard Health, AAD, PubMed Central</span>
                    <span>Collegiate Non-Profit Project</span>
                </div>
            `;

            preview.innerHTML = html;
        }

        function openIngredientModal(id) {
            const item = INGREDIENTS_DATA.find(x => x.id === id);
            if (!item) return;

            const modalContent = document.getElementById('modalContent');
            const isBeneficial = item.status === 'beneficial';

            modalContent.innerHTML = `
                <div class="space-y-4">
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] font-bold uppercase tracking-wider ${isBeneficial ? 'bg-green-100 text-green-800' : 'bg-terracotta/20 text-terracotta'} px-2.5 py-1 rounded-full">
                            ${isBeneficial ? 'Beneficial Ingredient' : 'High Risk / Potential Damager'}
                        </span>
                        <span class="text-xs text-eucalyptus font-semibold">${item.category}</span>
                    </div>

                    <h3 class="font-serif-title text-2xl font-bold text-sage">${item.inci}</h3>

                    <div class="bg-white p-4 rounded-2xl border border-eucalyptus/20 space-y-2 text-xs">
                        <div class="flex justify-between border-b border-eucalyptus/10 pb-2">
                            <span class="font-semibold text-sage/70">Molecular Weight:</span>
                            <span class="font-mono text-sage">${item.molWeight}</span>
                        </div>
                        <div class="flex justify-between border-b border-eucalyptus/10 pb-2">
                            <span class="font-semibold text-sage/70">Cuticle Penetration:</span>
                            <span class="text-sage">${item.penetration}</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="font-semibold text-sage/70">Academic Source:</span>
                            <span class="text-terracotta font-semibold">${item.source}</span>
                        </div>
                    </div>

                    <div>
                        <h4 class="text-xs font-bold uppercase tracking-wider text-sage mb-1">Chemical Mechanism of Action:</h4>
                        <p class="text-xs sm:text-sm text-sage/80 leading-relaxed bg-white/60 p-3 rounded-xl border border-eucalyptus/10">${item.mechanism}</p>
                    </div>

                    <div class="bg-linen border-l-4 border-terracotta p-3 rounded-r-xl text-xs">
                        <span class="font-bold text-sage block">Public Health Takeaway:</span>
                        <span class="text-sage/80">${item.notes}</span>
                    </div>
                </div>
            `;

            document.getElementById('ingredientModal').classList.remove('hidden');
        }

        function openTikTokModal(scriptId) {
            loadScript(scriptId);
            document.getElementById('tikTokModal').classList.remove('hidden');
        }

        function loadScript(scriptId) {
            const data = TIKTOK_SCRIPTS[scriptId] || TIKTOK_SCRIPTS[1];
            document.getElementById('modalEpTag').innerText = data.ep;
            document.getElementById('modalTopicTag').innerText = data.topic;
            document.getElementById('modalScriptTitle').innerText = data.title;
            document.getElementById('modalVideoHook').innerText = data.hookText;
            document.getElementById('modalVideoCitation').innerText = data.citation;
            document.getElementById('scriptHookText').innerText = data.hookText;
            document.getElementById('scriptScienceText').innerText = data.scienceText;
            document.getElementById('scriptActionText').innerText = data.actionText;
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }
    </script>
</body>
</html>
