<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hair Science Hub | College Non-Profit Initiative</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Lora:ital,wght@0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Tailwind Custom Configuration -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        linen: '#F9F8F6',
                        sage: {
                            DEFAULT: '#2C3E35',
                            dark: '#1d2b25',
                            light: '#3d5247'
                        },
                        eucalyptus: {
                            DEFAULT: '#7A9A8B',
                            light: '#e3ece8',
                            hover: '#698778'
                        },
                        terracotta: {
                            DEFAULT: '#D97757',
                            hover: '#c46445',
                            light: '#faeeea'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Lora', 'serif'],
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom Styles & Utilities */
        body {
            background-color: #F9F8F6;
            color: #2C3E35;
            font-family: 'Inter', sans-serif;
        }

        .font-serif-title {
            font-family: 'Lora', serif;
        }

        /* Perspective for 3D flip card effect */
        .perspective-1000 {
            perspective: 1000px;
        }
        .transform-style-3d {
            transform-style: preserve-3d;
        }
        .backface-hidden {
            backface-visibility: hidden;
        }
        .rotate-y-180 {
            transform: rotateY(180deg);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #F9F8F6;
        }
        ::-webkit-scrollbar-thumb {
            background: #7A9A8B;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #2C3E35;
        }

        @media print {
            .no-print {
                display: none !important;
            }
            .print-only {
                display: block !important;
            }
            body {
                background-color: #ffffff !important;
                color: #000000 !important;
            }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between antialiased selection:bg-eucalyptus selection:text-white">

    <!-- Navigation Bar -->
    <header class="sticky top-0 z-40 bg-linen/90 backdrop-blur-md border-b border-eucalyptus/20 no-print transition-all duration-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <a href="#" class="flex items-center gap-3 group">
                <div class="w-10 h-10 rounded-xl bg-sage text-linen flex items-center justify-center font-serif font-bold text-xl shadow-md group-hover:bg-terracotta transition-colors duration-300">
                    <i class="fa-solid font-normal fa-dna"></i>
                </div>
                <div>
                    <span class="font-serif-title text-xl font-bold tracking-tight text-sage block leading-none">Hair Science Hub</span>
                    <span class="text-xs text-eucalyptus font-semibold uppercase tracking-wider block mt-1">College Non-Profit Initiative</span>
                </div>
            </a>

            <!-- Desktop Nav -->
            <nav class="hidden md:flex items-center space-x-8 text-sm font-medium">
                <a href="#about" class="text-sage hover:text-terracotta transition-colors">About</a>
                <a href="#analyzer" class="text-sage hover:text-terracotta transition-colors">Ingredient Matrix</a>
                <a href="#myths" class="text-sage hover:text-terracotta transition-colors">Myth Busters</a>
                <a href="#references" class="text-sage hover:text-terracotta transition-colors">Academic Hub</a>
                <a href="#generator" class="text-sage hover:text-terracotta transition-colors">Cheat Sheet</a>
            </nav>

            <div class="hidden md:flex items-center gap-3">
                <button onclick="openTikTokModal(1)" class="bg-terracotta hover:bg-terracotta-hover text-white text-xs font-semibold px-4 py-2.5 rounded-full shadow-sm hover:shadow-md transition-all flex items-center gap-2">
                    <i class="fa-brands fa-tiktok"></i>
                    <span>TikTok Campaign</span>
                </button>
            </div>

            <!-- Mobile Menu Button -->
            <button id="mobileMenuBtn" class="md:hidden text-sage p-2 rounded-lg hover:bg-eucalyptus/10 focus:outline-none" aria-label="Toggle Navigation">
                <i class="fa-solid fa-bars text-xl"></i>
            </button>
        </div>

        <!-- Mobile Navigation Drawer -->
        <div id="mobileMenu" class="hidden md:hidden bg-linen border-b border-eucalyptus/20 px-4 pt-2 pb-6 space-y-3">
            <a href="#about" class="mobile-nav-link block px-3 py-2 rounded-md text-base font-medium text-sage hover:bg-eucalyptus/10">About Initiative</a>
            <a href="#analyzer" class="mobile-nav-link block px-3 py-2 rounded-md text-base font-medium text-sage hover:bg-eucalyptus/10">Chemical Matrix</a>
            <a href="#myths" class="mobile-nav-link block px-3 py-2 rounded-md text-base font-medium text-sage hover:bg-eucalyptus/10">TikTok Myth Busters</a>
            <a href="#references" class="mobile-nav-link block px-3 py-2 rounded-md text-base font-medium text-sage hover:bg-eucalyptus/10">Academic References</a>
            <a href="#generator" class="mobile-nav-link block px-3 py-2 rounded-md text-base font-medium text-sage hover:bg-eucalyptus/10">INCI Cheat Sheet</a>
            <button onclick="openTikTokModal(1)" class="w-full mt-2 bg-terracotta text-white text-sm font-semibold px-4 py-2.5 rounded-xl flex items-center justify-center gap-2">
                <i class="fa-brands fa-tiktok"></i>
                <span>Explore TikTok Series</span>
            </button>
        </div>
    </header>

    <main class="flex-grow">
        <!-- 1. HERO SECTION -->
        <section id="about" class="relative py-16 md:py-24 overflow-hidden border-b border-eucalyptus/15">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                    
                    <div class="lg:col-span-7 space-y-6 text-left">
                        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-eucalyptus/15 border border-eucalyptus/30 text-sage text-xs font-semibold tracking-wide">
                            <span class="w-2 h-2 rounded-full bg-terracotta animate-pulse"></span>
                            Collegiate Public Health & Science Communication Project
                        </div>
                        
                        <h1 class="font-serif-title text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-sage leading-tight">
                            Demystifying Hair Wellness Through <span class="text-terracotta underline decoration-eucalyptus/40 underline-offset-8">Peer-Reviewed Science</span>
                        </h1>
                        
                        <p class="text-base sm:text-lg text-sage/80 leading-relaxed font-normal max-w-2xl">
                            We are translating dense cosmetic chemistry, dermatological literature, and molecular trichology into actionable public health knowledge. Combating social media misinformation—one formula at a time.
                        </p>

                        <div class="pt-2 flex flex-wrap gap-4 items-center">
                            <a href="#analyzer" class="bg-sage hover:bg-sage-dark text-linen text-sm font-semibold px-6 py-3.5 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2">
                                <i class="fa-solid fa-flask text-eucalyptus"></i>
                                <span>Explore Ingredient Matrix</span>
                            </a>
                            <button onclick="openTikTokModal(1)" class="bg-linen hover:bg-eucalyptus/10 text-sage border border-sage/20 text-sm font-semibold px-6 py-3.5 rounded-xl transition-all duration-200 flex items-center gap-2">
                                <i class="fa-brands fa-tiktok text-terracotta"></i>
                                <span>Watch TikTok Series Pitch</span>
                            </button>
                        </div>

                        <!-- Stats / Badges -->
                        <div class="pt-8 grid grid-cols-3 gap-4 border-t border-eucalyptus/20 max-w-lg">
                            <div>
                                <span class="block text-2xl font-bold text-sage font-serif-title">100%</span>
                                <span class="text-xs text-sage/70 font-medium">Non-Profit & Unsponsored</span>
                            </div>
                            <div>
                                <span class="block text-2xl font-bold text-sage font-serif-title">2021–2026</span>
                                <span class="text-xs text-sage/70 font-medium">PubMed & AAD Sources</span>
                            </div>
                            <div>
                                <span class="block text-2xl font-bold text-sage font-serif-title">INCI</span>
                                <span class="text-xs text-sage/70 font-medium">Ingredient Standardized</span>
                            </div>
                        </div>
                    </div>

                    <!-- Hero Visual Card / TikTok Preview Teaser -->
                    <div class="lg:col-span-5 relative">
                        <div class="relative mx-auto max-w-xs sm:max-w-sm rounded-3xl bg-sage p-4 shadow-2xl border-4 border-eucalyptus/30 text-linen">
                            <div class="relative rounded-2xl overflow-hidden bg-sage-dark aspect-[9/16] flex flex-col justify-between p-5 border border-white/10 group">
                                
                                <!-- Fake Video Header -->
                                <div class="flex items-center justify-between z-10">
                                    <div class="flex items-center gap-2">
                                        <div class="w-8 h-8 rounded-full bg-terracotta flex items-center justify-center font-bold text-xs text-white">HS</div>
                                        <div>
                                            <span class="text-xs font-semibold block text-white">@HairScienceHub</span>
                                            <span class="text-[10px] text-eucalyptus block">College Public Health</span>
                                        </div>
                                    </div>
                                    <span class="bg-black/40 text-[10px] px-2 py-1 rounded-full text-white/80 backdrop-blur-sm">Series Ep. 01</span>
                                </div>

                                <!-- Overlay Mockup Content -->
                                <div class="my-auto text-center space-y-3 z-10 py-6">
                                    <div class="w-16 h-16 mx-auto rounded-full bg-terracotta/90 text-white flex items-center justify-center text-2xl cursor-pointer hover:scale-110 transition-transform shadow-lg group-hover:bg-terracotta" onclick="openTikTokModal(1)">
                                        <i class="fa-solid fa-play ml-1"></i>
                                    </div>
                                    <div class="bg-black/60 backdrop-blur-md p-3 rounded-xl border border-white/10 text-left">
                                        <span class="text-[10px] uppercase font-bold text-terracotta tracking-wider block">Script Preview #1</span>
                                        <h4 class="text-xs font-bold text-white mt-1">"Why your hair doesn't actually 'hate' silicones..."</h4>
                                        <p class="text-[11px] text-gray-300 mt-1">Explaining Amodimethicone's positive charge mechanism in 30 seconds.</p>
                                    </div>
                                </div>

                                <!-- Fake Video Footer -->
                                <div class="z-10 space-y-2">
                                    <div class="flex items-center justify-between text-xs text-white/70">
                                        <span><i class="fa-solid fa-flask text-eucalyptus mr-1"></i> Peer-Reviewed</span>
                                        <span><i class="fa-solid fa-check text-green-400 mr-1"></i> Non-Commercial</span>
                                    </div>
                                    <button onclick="openTikTokModal(1)" class="w-full bg-eucalyptus hover:bg-eucalyptus-hover text-sage-dark text-xs font-bold py-2 rounded-lg transition-colors text-center">
                                        Preview Script Outline
                                    </button>
                                </div>

                                <!-- Background Glow Effects -->
                                <div class="absolute -bottom-10 -right-10 w-40 h-40 bg-terracotta/20 rounded-full blur-2xl"></div>
                                <div class="absolute -top-10 -left-10 w-40 h-40 bg-eucalyptus/20 rounded-full blur-2xl"></div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- 2. CHEMICAL INGREDIENT ANALYZER & MATRIX -->
        <section id="analyzer" class="py-16 md:py-24 bg-white border-b border-eucalyptus/15">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                
                <div class="text-center max-w-3xl mx-auto mb-12">
                    <span class="text-xs font-bold uppercase tracking-wider text-terracotta bg-terracotta/10 px-3 py-1 rounded-full">Interactive Database</span>
                    <h2 class="font-serif-title text-3xl sm:text-4xl font-bold text-sage mt-3">Chemical Ingredient Matrix</h2>
                    <p class="text-sage/70 text-sm sm:text-base mt-2">Filter and evaluate cosmetic hair ingredients by functional class, molecular weight, cuticle penetration, and health impacts.</p>
                </div>

                <!-- Controls Bar: Search & Category Filters -->
                <div class="bg-linen p-4 sm:p-6 rounded-2xl border border-eucalyptus/20 mb-8 space-y-4">
                    <div class="flex flex-col md:flex-row gap-4 justify-between items-center">
                        
                        <!-- Search Bar -->
                        <div class="relative w-full md:w-80">
                            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-eucalyptus"></i>
                            <input type="text" id="searchInput" onkeyup="filterIngredients()" placeholder="Search INCI name or mechanism..." class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-eucalyptus/30 bg-white text-sage text-sm focus:outline-none focus:ring-2 focus:ring-eucalyptus">
                        </div>

                        <!-- Safety Status Filter -->
                        <div class="flex items-center gap-2 w-full md:w-auto overflow-x-auto pb-1 md:pb-0">
                            <span class="text-xs font-semibold text-sage/70 whitespace-nowrap mr-1">Classification:</span>
                            <button onclick="setStatusFilter('all')" id="status-all" class="status-btn active px-3 py-1.5 rounded-lg text-xs font-semibold bg-sage text-white transition-colors">All</button>
                            <button onclick="setStatusFilter('beneficial')" id="status-beneficial" class="status-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-white border border-eucalyptus/30 text-sage hover:bg-eucalyptus/10 transition-colors">Beneficial / Functional</button>
                            <button onclick="setStatusFilter('high-risk')" id="status-high-risk" class="status-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-white border border-eucalyptus/30 text-sage hover:bg-eucalyptus/10 transition-colors">High Risk / Damaging</button>
                        </div>
                    </div>

                    <!-- Category Pills -->
                    <div class="flex flex-wrap gap-2 pt-2 border-t border-eucalyptus/15">
                        <span class="text-xs font-semibold text-sage/70 self-center mr-2">Category:</span>
                        <button onclick="setCategoryFilter('all')" id="cat-all" class="cat-btn active bg-eucalyptus text-white px-3 py-1 rounded-full text-xs font-medium">All Categories</button>
                        <button onclick="setCategoryFilter('Cleansers')" id="cat-Cleansers" class="cat-btn bg-white border border-eucalyptus/30 text-sage px-3 py-1 rounded-full text-xs font-medium hover:bg-eucalyptus/10">Cleansers</button>
                        <button onclick="setCategoryFilter('Silicones')" id="cat-Silicones" class="cat-btn bg-white border border-eucalyptus/30 text-sage px-3 py-1 rounded-full text-xs font-medium hover:bg-eucalyptus/10">Silicones</button>
                        <button onclick="setCategoryFilter('Proteins')" id="cat-Proteins" class="cat-btn bg-white border border-eucalyptus/30 text-sage px-3 py-1 rounded-full text-xs font-medium hover:bg-eucalyptus/10">Proteins</button>
                        <button onclick="setCategoryFilter('Bond Builders')" id="cat-Bond Builders" class="cat-btn bg-white border border-eucalyptus/30 text-sage px-3 py-1 rounded-full text-xs font-medium hover:bg-eucalyptus/10">Bond Builders</button>
                        <button onclick="setCategoryFilter('Preservatives')" id="cat-Preservatives" class="cat-btn bg-white border border-eucalyptus/30 text-sage px-3 py-1 rounded-full text-xs font-medium hover:bg-eucalyptus/10">Preservatives</button>
                        <button onclick="setCategoryFilter('Alcohols')" id="cat-Alcohols" class="cat-btn bg-white border border-eucalyptus/30 text-sage px-3 py-1 rounded-full text-xs font-medium hover:bg-eucalyptus/10">Alcohols</button>
                    </div>
                </div>

                <!-- Table Container -->
                <div class="overflow-x-auto rounded-2xl border border-eucalyptus/20 shadow-sm bg-white">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-sage text-linen text-xs uppercase tracking-wider">
                                <th class="p-4 font-semibold">INCI Ingredient Name</th>
                                <th class="p-4 font-semibold">Category</th>
                                <th class="p-4 font-semibold">Classification</th>
                                <th class="p-4 font-semibold">Molecular Weight</th>
                                <th class="p-4 font-semibold">Cuticle Penetration</th>
                                <th class="p-4 font-semibold text-right">Details</th>
                            </tr>
                        </thead>
                        <tbody id="ingredientTableBody" class="divide-y divide-eucalyptus/15 text-xs sm:text-sm text-sage">
                            <!-- Populated via JavaScript -->
                        </tbody>
                    </table>
                </div>

                <div id="noResults" class="hidden text-center py-12 text-sage/60">
                    <i class="fa-solid fa-flask-vial text-3xl mb-2 text-eucalyptus"></i>
                    <p class="font-medium">No ingredients match your current search or filter criteria.</p>
                </div>
            </div>
        </section>

        <!-- 3. TIKTOK MYTH BUSTERS SECTION -->
        <section id="myths" class="py-16 md:py-24 bg-linen border-b border-eucalyptus/15">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                
                <div class="text-center max-w-3xl mx-auto mb-12">
                    <span class="text-xs font-bold uppercase tracking-wider text-terracotta bg-terracotta/10 px-3 py-1 rounded-full">Debunking Trends</span>
                    <h2 class="font-serif-title text-3xl sm:text-4xl font-bold text-sage mt-3">TikTok Viral Myth Busters</h2>
                    <p class="text-sage/70 text-sm sm:text-base mt-2">Click or tap any card to flip it and reveal the peer-reviewed clinical research behind popular hair care trends.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="mythsContainer">
                    <!-- Populated via JS -->
                </div>

            </div>
        </section>

        <!-- 4. EVIDENCE-BASED ACADEMIC REFERENCE CENTER -->
        <section id="references" class="py-16 md:py-24 bg-white border-b border-eucalyptus/15">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                
                <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-wider text-sage bg-eucalyptus/20 px-3 py-1 rounded-full">Academic Rigor</span>
                        <h2 class="font-serif-title text-3xl sm:text-4xl font-bold text-sage mt-3">Evidence-Based Reference Center</h2>
                        <p class="text-sage/70 text-sm mt-1">Complete APA 7th Edition citations focused on recent publications (2021–2026).</p>
                    </div>

                    <!-- Year Filter -->
                    <div class="flex items-center gap-2 self-start md:self-auto">
                        <span class="text-xs font-semibold text-sage/70">Filter Year:</span>
                        <select id="yearFilter" onchange="filterReferences()" class="bg-linen border border-eucalyptus/30 text-sage text-xs font-semibold rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-eucalyptus">
                            <option value="all">All Years (2021–2026)</option>
                            <option value="2025-2026">2025–2026 (Recent)</option>
                            <option value="2023-2024">2023–2024</option>
                            <option value="2021-2022">2021–2022</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-4" id="referenceList">
                    <!-- Populated via JS -->
                </div>

            </div>
        </section>

        <!-- 5. INCI LABEL CHEAT SHEET GENERATOR -->
        <section id="generator" class="py-16 md:py-24 bg-linen">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                
                <div class="bg-sage text-linen rounded-3xl p-6 sm:p-10 shadow-xl border border-eucalyptus/30">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                        
                        <div class="lg:col-span-5 space-y-4">
                            <span class="text-xs font-bold uppercase tracking-wider text-terracotta bg-terracotta/20 px-3 py-1 rounded-full">Interactive Utility</span>
                            <h2 class="font-serif-title text-3xl font-bold text-white leading-tight">Custom INCI Cheat Sheet Generator</h2>
                            <p class="text-linen/80 text-sm leading-relaxed">
                                Select key chemical topics below to dynamically generate a 1-page printable INCI label pocket guide for your college project or personal consumer use.
                            </p>

                            <div class="space-y-3 pt-2">
                                <label class="block text-xs font-semibold text-eucalyptus uppercase tracking-wider">Select Modules to Include:</label>
                                <div class="space-y-2">
                                    <label class="flex items-center gap-3 text-xs sm:text-sm text-linen cursor-pointer">
                                        <input type="checkbox" id="chk-surfactants" checked onchange="generateCheatSheet()" class="accent-terracotta w-4 h-4 rounded">
                                        <span>Surfactants & Cleansers (SLS vs. Glucosides)</span>
                                    </label>
                                    <label class="flex items-center gap-3 text-xs sm:text-sm text-linen cursor-pointer">
                                        <input type="checkbox" id="chk-silicones" checked onchange="generateCheatSheet()" class="accent-terracotta w-4 h-4 rounded">
                                        <span>Silicones & Polymers (Amodimethicone Charge)</span>
                                    </label>
                                    <label class="flex items-center gap-3 text-xs sm:text-sm text-linen cursor-pointer">
                                        <input type="checkbox" id="chk-proteins" checked onchange="generateCheatSheet()" class="accent-terracotta w-4 h-4 rounded">
                                        <span>Proteins & Bond Builders (Hydrolysis Weight)</span>
                                    </label>
                                    <label class="flex items-center gap-3 text-xs sm:text-sm text-linen cursor-pointer">
                                        <input type="checkbox" id="chk-preservatives" checked onchange="generateCheatSheet()" class="accent-terracotta w-4 h-4 rounded">
                                        <span>Preservatives & Alcohols (DMDM vs. Fatty Alcohols)</span>
                                    </label>
                                </div>
                            </div>

                            <div class="pt-4 flex gap-3">
                                <button onclick="window.print()" class="bg-terracotta hover:bg-terracotta-hover text-white text-xs sm:text-sm font-bold px-5 py-3 rounded-xl shadow-md transition-all flex items-center gap-2">
                                    <i class="fa-solid fa-print"></i>
                                    <span>Print / Export PDF Guide</span>
                                </button>
                            </div>
                        </div>

                        <!-- Live Printable Preview Box -->
                        <div class="lg:col-span-7 bg-white text-sage rounded-2xl p-6 shadow-inner border border-eucalyptus/20 text-xs leading-relaxed" id="cheatSheetPreview">
                            <!-- Dynamic Content Inserted Here -->
                        </div>

                    </div>
                </div>

            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-sage-dark text-linen/70 py-12 border-t border-eucalyptus/20 no-print">
